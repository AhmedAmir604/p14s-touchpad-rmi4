+static acpi_status
+piix4_asf_resource_cb(struct acpi_resource *resource, void *context)
+{
+	struct piix4_asf_acpi_resources *res = context;
+
+	switch (resource->type) {
+	case ACPI_RESOURCE_TYPE_IO: {
+		struct acpi_resource_io *io = &resource->data.io;
+
+		if (io->io_decode == ACPI_DECODE_16 &&
+		    io->minimum == io->maximum) {
+			res->io_base = io->minimum;
+			res->io_length = io->address_length;
+			res->io_found = true;
+		}
+		break;
+	}
+	case ACPI_RESOURCE_TYPE_IRQ: {
+		struct acpi_resource_irq *irq = &resource->data.irq;
+
+		if (irq->interrupt_count == 1 &&
+		    irq->triggering == ACPI_LEVEL_SENSITIVE &&
+		    irq->polarity == ACPI_ACTIVE_LOW &&
+		    irq->shareable == ACPI_SHARED) {
+			res->gsi = irq->interrupts[0];
+			res->irq_found = true;
+		}
+		break;
+	}
+	default:
+		break;
+	}
+
+	return AE_OK;
+}
+
+static acpi_status
+piix4_asf_device_cb(acpi_handle handle, u32 level, void *context,
+		    void **return_value)
+{
+	struct piix4_asf_acpi_resources candidate = { };
+	struct piix4_asf_acpi_resources *result = context;
+	acpi_status status;
+
+	status = acpi_walk_resources(handle, METHOD_NAME__CRS,
+				     piix4_asf_resource_cb, &candidate);
+	if (ACPI_FAILURE(status))
+		return AE_OK;
+
+	if (!candidate.io_found || !candidate.irq_found ||
+	    candidate.io_length != PIIX4_ASF_IO_SIZE)
+		return AE_OK;
+
+	candidate.valid = true;
+	*result = candidate;
+	return AE_CTRL_TERMINATE;
+}
+
+static bool piix4_asf_detect(struct pci_dev *dev)
+{
+	acpi_status status;
+
+	memset(&piix4_asf_resources, 0, sizeof(piix4_asf_resources));
+
+	if (!asf_host_notify)
+		return false;
+
+	if (!dmi_check_system(piix4_asf_dmi_table)) {
+		dev_warn(&dev->dev,
+			 "ASF Host Notify requested on unsupported DMI system\n");
+		return false;
+	}
+
+	if (dev->vendor != PCI_VENDOR_ID_AMD ||
+	    dev->device != PCI_DEVICE_ID_AMD_KERNCZ_SMBUS) {
+		dev_warn(&dev->dev,
+			 "ASF Host Notify requested on unsupported SMBus controller\n");
+		return false;
+	}
+
+	status = acpi_get_devices("SMB0001", piix4_asf_device_cb,
+				  &piix4_asf_resources, NULL);
+	if (ACPI_FAILURE(status) || !piix4_asf_resources.valid) {
+		dev_warn(&dev->dev,
+			 "SMB0001 lacks the required 32-byte I/O and level-low shared IRQ resources\n");
+		return false;
+	}
+
+	dev_info(&dev->dev,
+		 "validated legacy ASF resources: I/O 0x%x, GSI %u\n",
+		 piix4_asf_resources.io_base, piix4_asf_resources.gsi);
+	return true;
+}
+
+static unsigned short piix4_io_region_size(unsigned short smba)
+{
+	if (piix4_asf_resources.valid &&
+	    smba == piix4_asf_resources.io_base)
+		return PIIX4_ASF_IO_SIZE;
+
+	return SMBIOSIZE;
+}
