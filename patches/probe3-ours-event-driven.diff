+static int piix4_asf_acquire_semaphore(struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short piix4_smba = adapdata->smba;
+	int retries = PIIX4_ASF_SEMAPHORE_RETRIES;
+
+	do {
+		outb_p(PIIX4_ASF_HOST_SEMAPHORE,
+		       PIIX4_ASF_SEMAPHORE);
+		if (inb_p(PIIX4_ASF_SEMAPHORE) &
+		    PIIX4_ASF_HOST_SEMAPHORE)
+			return 0;
+
+		usleep_range(250, 500);
+	} while (--retries);
+
+	outb_p(PIIX4_ASF_CLEAR_SEMAPHORE, PIIX4_ASF_SEMAPHORE);
+	return -EBUSY;
+}
+
+static void piix4_asf_release_semaphore(
+				struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short piix4_smba = adapdata->smba;
+
+	outb_p(PIIX4_ASF_CLEAR_SEMAPHORE, PIIX4_ASF_SEMAPHORE);
+}
+
+static void
+piix4_asf_sample_bus_state(struct i2c_piix4_adapdata *adapdata,
+			   struct piix4_asf_bus_state *state)
+{
+	unsigned short piix4_smba = adapdata->smba;
+
+	state->host_status = inb_p(SMBHSTSTS);
+	if (state->host_status & PIIX4_ASF_HOST_BUSY) {
+		/*
+		 * Conservatively avoid cross-state sampling while the ASF host
+		 * is active.  FF marks the deliberately unsampled fields.
+		 */
+		state->asf_status = 0xff;
+		state->bank_select = 0xff;
+		return;
+	}
+	state->asf_status = inb_p(PIIX4_ASF_STATUS);
+	state->bank_select = inb_p(PIIX4_ASF_DATA_BANK_SELECT);
+}
+
+static bool
+piix4_asf_bus_is_idle(const struct piix4_asf_bus_state *state)
+{
+	/*
+	 * This revision reports SlaveIntr at ASFStatus bit 6 rather than the
+	 * documented bit 5.  DataBankSel is sampled for diagnostics, but its
+	 * reserved bit 6 is not used as a gate on this controller revision.
+	 */
+	return !(state->host_status & PIIX4_ASF_HOST_BUSY) &&
+	       !(state->asf_status &
+		 (PIIX4_ASF_ACTIVE_SLAVE_BUSY | PIIX4_ASF_SLAVE_INTR));
+}
+
+static int
+piix4_asf_wait_bus_idle(struct i2c_piix4_adapdata *adapdata,
+			struct piix4_asf_bus_state *first,
+			struct piix4_asf_bus_state *last)
+{
+	int attempt;
+
+	piix4_asf_sample_bus_state(adapdata, first);
+	*last = *first;
+
+	for (attempt = 0; attempt < PIIX4_ASF_BUS_IDLE_ATTEMPTS; attempt++) {
+		if (piix4_asf_bus_is_idle(last)) {
+			/*
+			 * Qualify an idle observation across one conservative
+			 * 100 kHz bus-free interval before programming ADD/CMD.
+			 */
+			udelay(PIIX4_ASF_BUS_FREE_US);
+			piix4_asf_sample_bus_state(adapdata, last);
+			if (piix4_asf_bus_is_idle(last))
+				return 0;
+		} else {
+			udelay(PIIX4_ASF_BUS_FREE_US);
+			piix4_asf_sample_bus_state(adapdata, last);
+		}
+	}
+
+	return -EBUSY;
+}
+
+static bool
+piix4_asf_read_notify_bank(struct i2c_piix4_adapdata *adapdata, u8 bank,
+			   u8 *notify_address)
+{
+	unsigned short piix4_smba = adapdata->smba;
+	u8 host_address;
+	u8 device_address;
+
+	outb_p(bank << PIIX4_ASF_READ_BANK_SHIFT,
+	       PIIX4_ASF_DATA_BANK_SELECT);
+	inb_p(SMBHSTCNT);	/* Reset the shared data index. */
+	host_address = inb_p(SMBBLKDAT);
+	device_address = inb_p(SMBBLKDAT);
+
+	if (host_address != (PIIX4_ASF_HOST_ADDRESS << 1) ||
+	    device_address != (PIIX4_ASF_RMI4_ADDRESS << 1))
+		return false;
+
+	*notify_address = device_address >> 1;
+	return true;
+}
+
+static bool
+piix4_asf_notify_rate_exceeded(struct i2c_piix4_adapdata *adapdata)
+{
+	const unsigned long capacity = PIIX4_ASF_NOTIFY_BURST * HZ;
+	unsigned long elapsed;
+	unsigned long now = jiffies;
+	bool exceeded;
+
+	raw_spin_lock(&adapdata->asf_rate_lock);
+	if (adapdata->asf_notify_rate_armed &&
+	    !adapdata->asf_notify_overrate) {
+		elapsed = now - adapdata->asf_notify_last_jiffies;
+		if (elapsed >=
+		    DIV_ROUND_UP(capacity, PIIX4_ASF_NOTIFY_RATE))
+			adapdata->asf_notify_tokens = capacity;
+		else
+			adapdata->asf_notify_tokens =
+				min(capacity,
+				    adapdata->asf_notify_tokens +
+				    elapsed * PIIX4_ASF_NOTIFY_RATE);
+		adapdata->asf_notify_last_jiffies = now;
+
+		if (adapdata->asf_notify_tokens >= HZ)
+			adapdata->asf_notify_tokens -= HZ;
+		else {
+			adapdata->asf_notify_overrate = true;
+			adapdata->asf_notify_rate_armed = false;
+		}
+	}
+	exceeded = adapdata->asf_notify_overrate;
+	raw_spin_unlock(&adapdata->asf_rate_lock);
+
+	return exceeded;
+}
+
+static bool
+piix4_asf_notify_is_overrate(struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned long flags;
+	bool exceeded;
+
+	raw_spin_lock_irqsave(&adapdata->asf_rate_lock, flags);
+	exceeded = adapdata->asf_notify_overrate;
+	if (exceeded)
+		adapdata->asf_notify_rate_armed = false;
+	raw_spin_unlock_irqrestore(&adapdata->asf_rate_lock, flags);
+
+	return exceeded;
+}
+
+static void
+piix4_asf_notify_rate_arm(struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&adapdata->asf_rate_lock, flags);
+	adapdata->asf_notify_tokens = PIIX4_ASF_NOTIFY_BURST * HZ;
+	adapdata->asf_notify_last_jiffies = jiffies;
+	adapdata->asf_notify_overrate = false;
+	adapdata->asf_notify_rate_armed = true;
+	raw_spin_unlock_irqrestore(&adapdata->asf_rate_lock, flags);
+}
+
+static void
+piix4_asf_notify_rate_disarm(struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&adapdata->asf_rate_lock, flags);
+	adapdata->asf_notify_rate_armed = false;
+	raw_spin_unlock_irqrestore(&adapdata->asf_rate_lock, flags);
+}
+
+static irqreturn_t piix4_asf_irq_handler(int irq, void *dev_id)
+{
+	struct i2c_piix4_adapdata *adapdata = dev_id;
+	unsigned short piix4_smba = adapdata->smba;
+	u8 host_status;
+	u8 asf_status;
+	bool complete_xfer = false;
+	bool handled = false;
+	bool wake_thread = false;
+
+	host_status = inb_p(SMBHSTSTS);
+	asf_status = inb_p(PIIX4_ASF_STATUS);
+
+	if (host_status & PIIX4_ASF_HOST_INTR) {
+		/*
+		 * Capture before clearing: the waiter must still see error
+		 * flags even though this level-triggered source is W1C.
+		 */
+		if (READ_ONCE(adapdata->asf_xfer_active)) {
+			WRITE_ONCE(adapdata->asf_host_status, host_status);
+			complete_xfer = true;
+		}
+		outb_p(host_status & PIIX4_ASF_HOST_STATUS_MASK, SMBHSTSTS);
+		if (complete_xfer)
+			complete(&adapdata->asf_completion);
+		handled = true;
+	} else if (!READ_ONCE(adapdata->asf_xfer_active) &&
+		   host_status & PIIX4_ASF_HOST_ERROR_MASK) {
+		outb_p(host_status & PIIX4_ASF_HOST_ERROR_MASK, SMBHSTSTS);
+		handled = true;
+	}
+
+	if (asf_status & PIIX4_ASF_SLAVE_INTR) {
+		/*
+		 * Clear the level source in hard IRQ context.  The thread may
+		 * wait for an in-flight host transaction on asf_lock.
+		 */
+		outb_p(PIIX4_ASF_SLAVE_INTR, PIIX4_ASF_STATUS);
+		piix4_asf_notify_rate_exceeded(adapdata);
+		atomic_set(&adapdata->asf_notify_pending, 1);
+		handled = true;
+		wake_thread = true;
+	}
+
+	if (wake_thread)
+		return IRQ_WAKE_THREAD;
+
+	return handled ? IRQ_HANDLED : IRQ_NONE;
+}
+
+static irqreturn_t piix4_asf_irq_thread(int irq, void *dev_id)
+{
+	struct i2c_piix4_adapdata *adapdata = dev_id;
+	struct i2c_adapter *adap = adapdata->asf_adapter;
+	unsigned short piix4_smba = adapdata->smba;
+	u8 notify_address[2];
+	u8 bank_select;
+	u8 clear_banks;
+	u8 remaining;
+	u8 asf_status;
+	int count;
+	int first;
+	int second;
+	int round;
+	int i;
+	bool rate_limited = false;
+
+	for (round = 0; round < PIIX4_ASF_NOTIFY_DRAIN_LIMIT; round++) {
+		if (piix4_asf_notify_is_overrate(adapdata)) {
+			rate_limited = true;
+			break;
+		}
+
+		count = 0;
+		clear_banks = 0;
+		atomic_set(&adapdata->asf_notify_pending, 0);
+
+		mutex_lock(&adapdata->asf_lock);
+		bank_select = inb_p(PIIX4_ASF_DATA_BANK_SELECT);
+		if (bank_select & PIIX4_ASF_LAST_BANK) {
+			first = 0;
+			second = 1;
+		} else {
+			first = 1;
+			second = 0;
+		}
+
+		if (bank_select & (first ? PIIX4_ASF_BANK1_FULL :
+					  PIIX4_ASF_BANK0_FULL)) {
+			clear_banks |= first ? PIIX4_ASF_BANK1_FULL :
+					       PIIX4_ASF_BANK0_FULL;
+			if (adapdata->asf_notify_enabled &&
+			    piix4_asf_read_notify_bank(
+				    adapdata, first, &notify_address[count]))
+				count++;
+		}
+
+		if (bank_select & (second ? PIIX4_ASF_BANK1_FULL :
+					   PIIX4_ASF_BANK0_FULL)) {
+			clear_banks |= second ? PIIX4_ASF_BANK1_FULL :
+						PIIX4_ASF_BANK0_FULL;
+			if (adapdata->asf_notify_enabled &&
+			    piix4_asf_read_notify_bank(
+				    adapdata, second, &notify_address[count]))
+				count++;
+		}
+
+		/* Clear only banks consumed from this snapshot. */
+		if (clear_banks)
+			outb_p(clear_banks, PIIX4_ASF_DATA_BANK_SELECT);
+		remaining = inb_p(PIIX4_ASF_DATA_BANK_SELECT) &
+			    PIIX4_ASF_BANK_FULL_MASK;
+		mutex_unlock(&adapdata->asf_lock);
+
+		for (i = 0; i < count; i++) {
+			if (READ_ONCE(adap->host_notify_domain))
+				i2c_handle_smbus_host_notify(
+					adap, notify_address[i]);
+		}
+
+		if (!remaining &&
+		    !atomic_read(&adapdata->asf_notify_pending))
+			return IRQ_HANDLED;
+	}
+
+	mutex_lock(&adapdata->asf_lock);
+	adapdata->asf_notify_enabled = false;
+	outb_p((inb_p(PIIX4_ASF_SLAVE_ENABLE) |
+		PIIX4_ASF_KILL_SLAVE) &
+	       ~PIIX4_ASF_SLAVE_INTR_ENABLE, PIIX4_ASF_SLAVE_ENABLE);
+	bank_select = inb_p(PIIX4_ASF_DATA_BANK_SELECT);
+	outb_p(bank_select & PIIX4_ASF_BANK_FULL_MASK,
+	       PIIX4_ASF_DATA_BANK_SELECT);
+	asf_status = inb_p(PIIX4_ASF_STATUS);
+	if (asf_status & PIIX4_ASF_SLAVE_INTR)
+		outb_p(PIIX4_ASF_SLAVE_INTR, PIIX4_ASF_STATUS);
+	mutex_unlock(&adapdata->asf_lock);
+	piix4_asf_notify_rate_disarm(adapdata);
+	if (rate_limited)
+		dev_err(adapdata->asf_dev,
+			"ASF notification rate exceeded %u/s; notifications disabled\n",
+			PIIX4_ASF_NOTIFY_RATE);
+	else
+		dev_err(adapdata->asf_dev,
+			"ASF notification flood did not drain; notifications disabled\n");
+
+	return IRQ_HANDLED;
+}
+
+static void
+piix4_asf_restore_registers(struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short piix4_smba = adapdata->smba;
+	bool semaphore_held;
+	u8 status;
+
+	semaphore_held = !piix4_asf_acquire_semaphore(adapdata);
+	if (!semaphore_held)
+		dev_err(adapdata->asf_dev,
+			"forcing ASF register restore without the host semaphore\n");
+
+	status = inb_p(SMBHSTSTS) & PIIX4_ASF_HOST_STATUS_MASK;
+	if (status)
+		outb_p(status, SMBHSTSTS);
+	status = inb_p(PIIX4_ASF_STATUS);
+	if (status & PIIX4_ASF_SLAVE_INTR)
+		outb_p(PIIX4_ASF_SLAVE_INTR, PIIX4_ASF_STATUS);
+
+	outb_p(adapdata->asf_orig_bank_select,
+	       PIIX4_ASF_DATA_BANK_SELECT);
+	outb_p(adapdata->asf_orig_listen_address,
+	       PIIX4_ASF_LISTEN_ADDRESS);
+	outb_p(adapdata->asf_orig_delay_master_timer,
+	       PIIX4_ASF_DELAY_MASTER_TIMER);
+	outb_p(adapdata->asf_orig_slave_enable,
+	       PIIX4_ASF_SLAVE_ENABLE);
+	if (semaphore_held)
+		piix4_asf_release_semaphore(adapdata);
+
+	if (inb_p(PIIX4_ASF_LISTEN_ADDRESS) !=
+			adapdata->asf_orig_listen_address ||
+	    inb_p(PIIX4_ASF_DELAY_MASTER_TIMER) !=
+			adapdata->asf_orig_delay_master_timer ||
+	    inb_p(PIIX4_ASF_SLAVE_ENABLE) !=
+			adapdata->asf_orig_slave_enable)
+		dev_err(adapdata->asf_dev,
+			"failed to restore original ASF register state\n");
+}
+
+static int piix4_asf_prepare(struct pci_dev *dev, struct i2c_adapter *adap)
+{
+	struct i2c_piix4_adapdata *adapdata = i2c_get_adapdata(adap);
+	struct irq_data *irq_data;
+	unsigned short piix4_smba = adapdata->smba;
+	u8 status;
+	int retval;
+
+	init_completion(&adapdata->asf_completion);
+	mutex_init(&adapdata->asf_lock);
+	raw_spin_lock_init(&adapdata->asf_rate_lock);
+	atomic_set(&adapdata->asf_notify_pending, 0);
+	adapdata->asf_notify_rate_armed = false;
+	adapdata->asf_notify_overrate = false;
+	adapdata->asf_irq = -1;
+	adapdata->asf_gsi = piix4_asf_resources.gsi;
+
+	retval = piix4_asf_acquire_semaphore(adapdata);
+	if (retval) {
+		dev_err(adapdata->asf_dev,
+			"failed to acquire ASF semaphore during setup\n");
+		return retval;
+	}
+
+	adapdata->asf_orig_listen_address =
+		inb_p(PIIX4_ASF_LISTEN_ADDRESS);
+	adapdata->asf_orig_slave_enable =
+		inb_p(PIIX4_ASF_SLAVE_ENABLE);
+	adapdata->asf_orig_bank_select =
+		inb_p(PIIX4_ASF_DATA_BANK_SELECT) &
+		(PIIX4_ASF_READ_HOST_BANK | GENMASK(5, 4));
+	adapdata->asf_orig_delay_master_timer =
+		inb_p(PIIX4_ASF_DELAY_MASTER_TIMER);
+
+	/* Keep target interrupts quiescent until the IRQ domain exists. */
+	outb_p((adapdata->asf_orig_slave_enable |
+		PIIX4_ASF_KILL_SLAVE) &
+	       ~PIIX4_ASF_SLAVE_INTR_ENABLE, PIIX4_ASF_SLAVE_ENABLE);
+	status = inb_p(SMBHSTSTS) & PIIX4_ASF_HOST_STATUS_MASK;
+	if (status)
+		outb_p(status, SMBHSTSTS);
+	status = inb_p(PIIX4_ASF_STATUS);
+	if (status & PIIX4_ASF_SLAVE_INTR)
+		outb_p(PIIX4_ASF_SLAVE_INTR, PIIX4_ASF_STATUS);
+	piix4_asf_release_semaphore(adapdata);
+
+	retval = acpi_register_gsi(&dev->dev, adapdata->asf_gsi,
+				   ACPI_LEVEL_SENSITIVE, ACPI_ACTIVE_LOW);
+	if (retval < 0) {
+		dev_err(adapdata->asf_dev,
+			"failed to map ASF GSI %u: %d\n",
+			adapdata->asf_gsi, retval);
+		piix4_asf_restore_registers(adapdata);
+		return retval;
+	}
+
+	adapdata->asf_irq = retval;
+	adapdata->asf_gsi_registered = true;
+	irq_data = irq_get_irq_data(adapdata->asf_irq);
+	if (!irq_data || !irqd_is_level_type(irq_data)) {
+		dev_err(adapdata->asf_dev,
+			"ASF IRQ %d was not configured as level-triggered\n",
+			adapdata->asf_irq);
+		retval = -EINVAL;
+		goto unregister_gsi;
+	}
+
+	/*
+	 * Do not use IRQF_ONESHOT: the thread can wait on asf_lock while the
+	 * hard handler must remain able to deliver a host completion.
+	 * IRQF_NO_THREAD preserves that split even with forced threading.
+	 */
+	retval = request_threaded_irq(adapdata->asf_irq,
+				      piix4_asf_irq_handler,
+				      piix4_asf_irq_thread,
+				      IRQF_SHARED | IRQF_TRIGGER_LOW |
+				      IRQF_NO_THREAD,
+				      "piix4_smbus_asf", adapdata);
+	if (retval) {
+		dev_err(adapdata->asf_dev,
+			"failed to request ASF IRQ %d: %d\n",
+			adapdata->asf_irq, retval);
+		goto unregister_gsi;
+	}
+
+	adapdata->asf_prepared = true;
+	dev_info(adapdata->asf_dev,
+		 "ASF IRQ %d prepared as level-low shared interrupt\n",
+		 adapdata->asf_irq);
+	return 0;
+
+unregister_gsi:
+	acpi_unregister_gsi(adapdata->asf_gsi);
+	adapdata->asf_gsi_registered = false;
+	adapdata->asf_irq = -1;
+	piix4_asf_restore_registers(adapdata);
+	return retval;
+}
+
+static int piix4_asf_enable_notify(struct i2c_adapter *adap)
+{
+	struct i2c_piix4_adapdata *adapdata = i2c_get_adapdata(adap);
+	unsigned short piix4_smba = adapdata->smba;
+	u8 bank_select;
+	u8 listen_address;
+	u8 slave_enable;
+	u8 status;
+	int retval;
+
+	if (!adapdata->asf_prepared || !adap->host_notify_domain)
+		return -EINVAL;
+
+	mutex_lock(&adapdata->asf_lock);
+	retval = piix4_asf_acquire_semaphore(adapdata);
+	if (retval)
+		goto unlock;
+
+	bank_select = inb_p(PIIX4_ASF_DATA_BANK_SELECT);
+	outb_p(bank_select & PIIX4_ASF_BANK_FULL_MASK,
+	       PIIX4_ASF_DATA_BANK_SELECT);
+	status = inb_p(PIIX4_ASF_STATUS);
+	if (status & PIIX4_ASF_SLAVE_INTR)
+		outb_p(PIIX4_ASF_SLAVE_INTR, PIIX4_ASF_STATUS);
+
+	listen_address = (PIIX4_ASF_HOST_ADDRESS << 1) |
+			 PIIX4_ASF_LISTEN_ENABLE;
+	slave_enable = (adapdata->asf_orig_slave_enable |
+			PIIX4_ASF_SLAVE_INTR_ENABLE |
+			PIIX4_ASF_FAIR_ARB_ENABLE) &
+		       ~PIIX4_ASF_KILL_SLAVE;
+	outb_p(listen_address, PIIX4_ASF_LISTEN_ADDRESS);
+	outb_p(PIIX4_ASF_FAIR_ARB_TIMER, PIIX4_ASF_DELAY_MASTER_TIMER);
+	piix4_asf_notify_rate_arm(adapdata);
+	outb_p(slave_enable, PIIX4_ASF_SLAVE_ENABLE);
+
+	if (inb_p(PIIX4_ASF_LISTEN_ADDRESS) != listen_address ||
+	    inb_p(PIIX4_ASF_DELAY_MASTER_TIMER) !=
+			PIIX4_ASF_FAIR_ARB_TIMER ||
+	    (inb_p(PIIX4_ASF_SLAVE_ENABLE) &
+	     (PIIX4_ASF_SLAVE_INTR_ENABLE | PIIX4_ASF_FAIR_ARB_ENABLE)) !=
+			(PIIX4_ASF_SLAVE_INTR_ENABLE |
+			 PIIX4_ASF_FAIR_ARB_ENABLE) ||
+	    (inb_p(PIIX4_ASF_SLAVE_ENABLE) & PIIX4_ASF_KILL_SLAVE)) {
+		dev_err(&adap->dev,
+			"ASF Host Notify register verification failed\n");
+		retval = -EIO;
+	} else {
+		adapdata->asf_notify_enabled = true;
+		dev_info(&adap->dev,
+			 "event-driven ASF Host Notify enabled with 64 us fair arbitration\n");
+	}
+
+	piix4_asf_release_semaphore(adapdata);
+unlock:
+	mutex_unlock(&adapdata->asf_lock);
+	return retval;
+}
+
+static void piix4_asf_disable_notify(struct i2c_adapter *adap)
+{
+	struct i2c_piix4_adapdata *adapdata = i2c_get_adapdata(adap);
+	unsigned short piix4_smba = adapdata->smba;
+	u8 bank_select;
+	u8 status;
+
+	if (!adapdata->asf_prepared)
+		return;
+
+	mutex_lock(&adapdata->asf_lock);
+	adapdata->asf_notify_enabled = false;
+	if (!piix4_asf_acquire_semaphore(adapdata)) {
+		outb_p((adapdata->asf_orig_slave_enable |
+			PIIX4_ASF_KILL_SLAVE) &
+		       ~PIIX4_ASF_SLAVE_INTR_ENABLE,
+		       PIIX4_ASF_SLAVE_ENABLE);
+		outb_p(adapdata->asf_orig_listen_address,
+		       PIIX4_ASF_LISTEN_ADDRESS);
+		outb_p(adapdata->asf_orig_delay_master_timer,
+		       PIIX4_ASF_DELAY_MASTER_TIMER);
+
+		bank_select = inb_p(PIIX4_ASF_DATA_BANK_SELECT);
+		outb_p(bank_select & PIIX4_ASF_BANK_FULL_MASK,
+		       PIIX4_ASF_DATA_BANK_SELECT);
+		status = inb_p(PIIX4_ASF_STATUS);
+		if (status & PIIX4_ASF_SLAVE_INTR)
+			outb_p(PIIX4_ASF_SLAVE_INTR, PIIX4_ASF_STATUS);
+		piix4_asf_release_semaphore(adapdata);
+	} else {
+		dev_err(adapdata->asf_dev,
+			"forcing ASF notification shutdown without the host semaphore\n");
+		outb_p((adapdata->asf_orig_slave_enable |
+			PIIX4_ASF_KILL_SLAVE) &
+		       ~PIIX4_ASF_SLAVE_INTR_ENABLE,
+		       PIIX4_ASF_SLAVE_ENABLE);
+		outb_p(adapdata->asf_orig_listen_address,
+		       PIIX4_ASF_LISTEN_ADDRESS);
+		outb_p(adapdata->asf_orig_delay_master_timer,
+		       PIIX4_ASF_DELAY_MASTER_TIMER);
+		bank_select = inb_p(PIIX4_ASF_DATA_BANK_SELECT);
+		outb_p(bank_select & PIIX4_ASF_BANK_FULL_MASK,
+		       PIIX4_ASF_DATA_BANK_SELECT);
+		status = inb_p(PIIX4_ASF_STATUS);
+		if (status & PIIX4_ASF_SLAVE_INTR)
+			outb_p(PIIX4_ASF_SLAVE_INTR, PIIX4_ASF_STATUS);
+	}
+	mutex_unlock(&adapdata->asf_lock);
+	piix4_asf_notify_rate_disarm(adapdata);
+
+	synchronize_irq(adapdata->asf_irq);
+}
+
+static void
+piix4_asf_unprepare(struct i2c_piix4_adapdata *adapdata)
+{
+	if (!adapdata->asf_prepared)
+		return;
+
+	free_irq(adapdata->asf_irq, adapdata);
+	if (adapdata->asf_gsi_registered)
+		acpi_unregister_gsi(adapdata->asf_gsi);
+
+	mutex_lock(&adapdata->asf_lock);
+	piix4_asf_restore_registers(adapdata);
+	mutex_unlock(&adapdata->asf_lock);
+
+	adapdata->asf_gsi_registered = false;
+	adapdata->asf_prepared = false;
+	adapdata->asf_irq = -1;
+}
+
+static int
+piix4_asf_quiesce_host_irq(struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short piix4_smba = adapdata->smba;
+	u8 status;
+	int attempt;
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		status = inb_p(SMBHSTSTS) & PIIX4_ASF_HOST_STATUS_MASK;
+		if (status)
+			outb_p(status, SMBHSTSTS);
+
+		/*
+		 * An old handler which already sampled Intr must finish while
+		 * asf_xfer_active is false.  A merely pending vector is safe
+		 * only after its hardware status has also been verified clear.
+		 */
+		synchronize_hardirq(adapdata->asf_irq);
+		if (!(inb_p(SMBHSTSTS) & PIIX4_ASF_HOST_STATUS_MASK))
+			return 0;
+	}
+
+	adapdata->asf_host_stuck = true;
+	dev_err(adapdata->asf_dev,
+		"failed to quiesce the ASF host interrupt; bus disabled\n");
+	return -EIO;
+}
+
+static void
+piix4_asf_abort_host(struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short piix4_smba = adapdata->smba;
+	u8 control;
+	u8 status;
+	int retries = 100;
+
+	control = inb_p(SMBHSTCNT);
+	outb_p(control | PIIX4_ASF_KILL_HOST, SMBHSTCNT);
+	do {
+		status = inb_p(SMBHSTSTS);
+		if (!(status & PIIX4_ASF_HOST_BUSY))
+			break;
+		usleep_range(100, 200);
+	} while (--retries);
+	outb_p(control & ~PIIX4_ASF_KILL_HOST, SMBHSTCNT);
+
+	if (status & PIIX4_ASF_HOST_BUSY) {
+		adapdata->asf_host_stuck = true;
+		dev_err(adapdata->asf_dev,
+			"ASF host remained busy after KillHost; slave left disabled\n");
+	}
+}
